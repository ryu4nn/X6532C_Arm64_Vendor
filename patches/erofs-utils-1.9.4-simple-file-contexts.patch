+static int selabel_entry_cmp(const void *a, const void *b)
+{
+	return strcmp(((const struct erofs_selabel_entry *)a)->path,
+		      ((const struct erofs_selabel_entry *)b)->path);
+}
+
+/*
+ * Bare-bones replacement for libselinux' SELABEL_CTX_FILE: the contexts file
+ * is a sorted list of literal "<path> <context>" pairs and matching is exact
+ * instead of regex based.  Callers must therefore pass a file with one line
+ * per path, which is what the Android vendor tree needs.
+ */
+int erofs_selabel_open(const char *file_contexts)
+{
+	struct erofs_selabel_map *map;
+	FILE *fp;
+	char *line = NULL;
+	size_t cap = 0, alloc = 0;
+	ssize_t len;
+
+	if (cfg.sehnd) {
+		erofs_info("ignore duplicated file contexts \"%s\"",
+			   file_contexts);
+		return -EBUSY;
+	}
+	fp = fopen(file_contexts, "r");
+	if (!fp) {
+		erofs_err("failed to open file contexts \"%s\"", file_contexts);
+		return -EINVAL;
+	}
+
+	map = calloc(1, sizeof(*map));
+	if (!map) {
+		fclose(fp);
+		return -ENOMEM;
+	}
+
+	while ((len = getline(&line, &cap, fp)) > 0) {
+		char *p = line, *ctx, *end;
+
+		while (*p == ' ' || *p == '\t')
+			++p;
+		if (*p == '#' || *p == '\n' || !*p)
+			continue;
+		ctx = p;
+		while (*ctx && *ctx != ' ' && *ctx != '\t')
+			++ctx;
+		if (!*ctx)
+			continue;
+		*ctx++ = '\0';
+		while (*ctx == ' ' || *ctx == '\t')
+			++ctx;
+		end = ctx + strlen(ctx);
+		while (end > ctx && (end[-1] == '\n' || end[-1] == '\r' ||
+				     end[-1] == ' ' || end[-1] == '\t'))
+			--end;
+		*end = '\0';
+		if (!*ctx)
+			continue;
+
+		if (map->nr == alloc) {
+			struct erofs_selabel_entry *n;
+
+			alloc = alloc ? alloc * 2 : 1024;
+			n = realloc(map->ent, alloc * sizeof(*n));
+			if (!n) {
+				free(line);
+				fclose(fp);
+				free(map);
+				return -ENOMEM;
+			}
+			map->ent = n;
+		}
+		map->ent[map->nr].path = strdup(p);
+		map->ent[map->nr].ctx = strdup(ctx);
+		if (!map->ent[map->nr].path || !map->ent[map->nr].ctx) {
+			free(line);
+			fclose(fp);
+			return -ENOMEM;
+		}
+		++map->nr;
+	}
+	free(line);
+	fclose(fp);
+
+	qsort(map->ent, map->nr, sizeof(*map->ent), selabel_entry_cmp);
+	cfg.sehnd = map;
+	erofs_info("loaded %zu file context entries from \"%s\"",
+		   map->nr, file_contexts);
+	return 0;
+}
+
+const char *erofs_selabel_lookup(void *handle, const char *path)
+{
+	struct erofs_selabel_map *map = handle;
+	struct erofs_selabel_entry key, *hit;
+
+	if (!map || !map->nr)
+		return NULL;
+	key.path = (char *)path;
+	hit = bsearch(&key, map->ent, map->nr, sizeof(*map->ent),
+		      selabel_entry_cmp);
+	return hit ? hit->ctx : NULL;
+}
